# ---- 运行时产物 ----
.profiles/
.profiles-demo/
logs/
*.log

# 本地配置（含学校/账号相关设置，不入库）
config.yaml

# 进度与待核对题目（个人数据）
data/progress.json
data/pending.jsonl
data/*.tmp

# 题库是本地产物；示例题库用 data/seed.jsonl 分发
data/bank.db
data/*.db-journal
data/*.db-wal

# 字体反爬的临时产物（运行时重新生成）
data/fonts/
data/glyph_cache*.npz

# 调试存档 / 诊断输出
data/debug/
data/*.txt
data/*.png
data/serve.pid
*.html.bak

# 一次性调试脚本
scripts/_*.py

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 打包产物 ----
*.zip
*.7z

